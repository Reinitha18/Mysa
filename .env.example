# Copier ce fichier vers .env et renseigner les vraies valeurs (ne jamais committer .env)

# Utilisé seulement hors Docker (moteur lancé à la main) ; avec Docker, le moteur joint « broker ».
MQTT_HOST=192.168.50.20
# 8883 = port TLS du broker sécurisé ; 1883 seulement avec le Mosquitto local de développement (MQTT_USE_TLS=false)
MQTT_PORT=8883
MQTT_USER=mysa-engine
MQTT_PASSWORD=change-me
MQTT_USE_TLS=true
# Chemin vers ca.crt (CA privée du broker). Vide = autorités système.
MQTT_CA_CERT=./broker/certs/ca.crt

DB_PATH=./mysa.db

# --- Réglages du moteur (facultatifs) ---
# Dossier des modèles locaux et des historiques d'apprentissage (défaut : engine/models)
# MYSA_MODELS_DIR=./engine/models
# true : accepte l'horodatage « ts » envoyé par l'appareil (nécessaire aux appareils virtuels accélérés).
# false (recommandé avec les seuls nœuds ESP32) : le moteur horodate chaque message à sa réception.
MYSA_TRUST_DEVICE_TS=true
# 1 : les modèles de référence lèvent aussi des alertes pendant l'amorçage (essais de l'hypothèse H1).
# Par défaut ils ne servent qu'à filtrer la baseline (voir engine/analyzer.py).
MYSA_REFERENCE_ALERTS=0
# 1 : configuration « apprentissage depuis zéro », sans modèle de référence
MYSA_DISABLE_REFERENCE=0

# --- Notifications (toutes facultatives ; un canal non renseigné est ignoré) ---
# Voir docs/notifications.md pour créer les comptes et les clés. Mettre MYSA_NOTIFY=0 pour tout couper.
MYSA_NOTIFY=1
# E-mail par SMTP (ex. Gmail + mot de passe d'application). 587 = STARTTLS, 465 = SSL.
MYSA_SMTP_HOST=smtp.gmail.com
MYSA_SMTP_PORT=587
MYSA_SMTP_USER=
MYSA_SMTP_PASSWORD=
MYSA_SMTP_FROM=
MYSA_SMTP_TO=
# SMS : passerelle HTTP d'un téléphone Android (ex. android-sms-gateway, capcom6, mode local).
MYSA_SMS_URL=
MYSA_SMS_USER=
MYSA_SMS_PASSWORD=
MYSA_SMS_TO=

# --- Caméra du téléphone ---
# Compte MQTT dédié avec lequel le hub publie home/cam-01/motion (ACL : home/cam-01/# seulement).
MYSA_CAM_DEVICE=cam-01
MYSA_CAM_USER=mysa-cam
MYSA_CAM_PASSWORD=change-me

# --- Déploiement Docker / Windows (deploy/mysa-start.ps1) ---
# IP fixe de CE PC (ipconfig) : certificat « mysa-hub », URL affichées, et adresse que les ESP32 contactent.
MYSA_HUB_IP=192.168.50.20
# Mots de passe des comptes MQTT du broker, recréés dans broker/passwd dès qu'ils changent ici.
# Lettres, chiffres, - et _ seulement. Ceux des nœuds sont lus par le firmware à la compilation.
MYSA_SEC_PASSWORD=change-me
MYSA_CMF_PASSWORD=change-me

# --- Wi-Fi des nœuds ESP32 (lu à la compilation : firmware/scripts/gen_config.py) ---
MYSA_WIFI_SSID=
MYSA_WIFI_PASS=

# --- Accès au dashboard ---
# Mot de passe demandé par le dashboard (et la page caméra) : il commande la serrure et l'alarme.
# Vide = sans mot de passe, à réserver au développement.
MYSA_DASHBOARD_PASSWORD=
