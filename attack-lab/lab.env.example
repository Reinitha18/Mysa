# Configuration du lab d'attaque Mysa (copier vers lab.env).
# Charger avant de lancer les scénarios :  set -a; source attack-lab/lab.env; set +a

# Cible : le hub Mysa (VLAN 30 dans GNS3).
TARGET_HOST=192.168.30.20
MQTT_PORT=8883

# Certificat de la CA Mysa (copié depuis broker/certs/ca.crt du hub) : permet d'établir le TLS.
# Laisser vide pour un TLS sans vérification de la chaîne.
CA_CERT=./ca.crt

# API du hub, pour MESURER la détection côté défenseur (lecture des alertes).
API_BASE=https://192.168.30.20:8000

# Nœud supposé COMPROMIS (scénarios d'injection / saturation) : identifiants d'un ESP32.
STOLEN_USER=esp32-sec-01
STOLEN_PASSWORD=change-me

# TI-02 : compte visé par la force brute.
BRUTE_USER=mysa-engine

# TI-04 : nombre de messages de la rafale.
FLOOD_COUNT=500
